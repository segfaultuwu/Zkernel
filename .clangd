CompileFlags:
  Add:
    - -x
    - c
    - -std=gnu11
    - --target=x86_64-unknown-none
    - -mno-red-zone
    - -mno-mmx
    - -mno-sse
    - -mno-sse2
    - -mno-3dnow
    - -mno-avx
    - -fno-pie
    - -fno-asynchronous-unwind-tables
    - -fno-stack-protector
    - -fno-stack-check
    - -fno-builtin
    - -fno-omit-frame-pointer
    - -fno-unwind-tables
    - -fno-stack-clash-protection
    - -ffreestanding
    - -I/home/segfault/Projekty/Zkernel/include
    - -I/home/segfault/Projekty/Zkernel/src
    - -I/home/segfault/Projekty/Zkernel/extern/flanterm/src
    - -I/home/segfault/Projekty/Zkernel/extern/limine-protocol/include
    - -I/home/segfault/Projekty/Zkernel/extern/limine
    - -DZK_ARCH_X86_64

  Remove:
    - -Werror
    - -std=gnu20
    - -std=gnu23
    - -std=gnu2x
    - -std=gnu++*
    - -xobjective-c++
    - -x
    - objective-c++

Diagnostics:
  Suppress:
    - unused-includes
    - missing-includes

Index:
  Background: Build
