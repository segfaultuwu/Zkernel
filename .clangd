CompileFlags:
  Add:
    - --target=x86_64-unknown-none
    - -std=gnu11
    - -ffreestanding
    - -I/home/segfault/Projekty/Zkernel/include
    - -I/home/segfault/Projekty/Zkernel/src
    - -I/home/segfault/Projekty/Zkernel/extern/flanterm/src
    - -I/home/segfault/Projekty/Zkernel/extern/limine-protocol/include
    - -I/home/segfault/Projekty/Zkernel/extern/limine
  Remove:
    - -Werror

Diagnostics:
  Suppress:
    - unused-includes
    - missing-includes

Index:
  Background: Build
